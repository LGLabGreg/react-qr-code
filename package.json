{
  "name": "root",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/LGLabGreg/react-qr-code.git"
  },
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm concurrently --names packages,apps \"pnpm watch:packages\" \"pnpm watch:docs\"",
    "watch:packages": "pnpm --filter \"./packages/**\" run dev",
    "watch:docs": "pnpm --filter \"./apps/docs/**\" run dev",
    "build:lib": "pnpm --filter \"./packages/**\" run build",
    "example:native": "pnpm build:lib && pnpm --filter react-qr-code-native-example start",
    "ci:publish": "pnpm build:lib && pnpm publish -r --no-git-checks && pnpm changeset git-tag",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "pnpm build:lib && pnpm --filter \"./packages/**\" run test:smoke",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "oxfmt"
    ],
    "packages/**/*.{ts,tsx}": [
      "oxlint --deny-warnings"
    ],
    "apps/docs/**/!(*.d).{ts,tsx}": [
      "oxlint --config apps/docs/.oxlintrc.json --deny-warnings"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "^10.0.7",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
