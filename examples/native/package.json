{
  "name": "react-qr-code-native-example",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export --platform android --platform ios --platform web --output-dir dist"
  },
  "dependencies": {
    "@lglab/react-qr-code": "workspace:*",
    "expo": "~58.0.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "dependenciesMeta": {
    "@lglab/react-qr-code": {
      "injected": true
    }
  }
}
